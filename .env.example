# Muslimin e.V. Platform - Environment Variables
# Copy this file to .env.local and fill in the actual values

# PayPal Configuration
# Get your PayPal hosted button ID from: https://www.paypal.com/donate/buttons/manage
# Format: NEXT_PUBLIC_PAYPAL_BUTTON_ID=XXXXXXXXXX
NEXT_PUBLIC_PAYPAL_BUTTON_ID=

# Bank Details for Donations (REQUIRED for production)
# IMPORTANT: Replace these placeholder values with actual bank account details before deployment
NEXT_PUBLIC_BANK_IBAN=DE12 3012 0000 0123456789
NEXT_PUBLIC_BANK_BIC=DEUTDE33
NEXT_PUBLIC_BANK_ACCOUNT_HOLDER=Muslimin e.V.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key

# Google Maps API (for location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
